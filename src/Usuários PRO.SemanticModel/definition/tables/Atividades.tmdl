	column _TipoDeObjeto = ```
			
			VAR API =
			    CONTAINSSTRING ( Atividades[Activity], "get" )
			VAR FOLDER =
			    CONTAINSSTRING ( Atividades[Activity], "folder" )
			        || CONTAINSSTRING ( Atividades[Activity], "label" )
			VAR DatSet =
			    CONTAINSSTRING ( Atividades[Activity], "dataset" )
			VAR COPILOT =
			    CONTAINSSTRING ( Atividades[Activity], "copilot" )
			VAR REPORT =
			    CONTAINSSTRING ( Atividades[Activity], "report" )
			        || CONTAINSSTRING ( Atividades[Activity], "import" )
			VAR ATUALIZACAO =
			    CONTAINSSTRING ( Atividades[Activity], "refresh" )
			VAR ACESSO =
			    CONTAINSSTRING ( Atividades[Activity], "access" )
			VAR LAKE =
			    CONTAINSSTRING ( Atividades[Activity], "ShareArtifact" )
			        || CONTAINSSTRING ( Atividades[Activity], "lake" )
			VAR exter =
			    CONTAINSSTRING ( Atividades[Activity], "external" )
			VAR app =
			    CONTAINSSTRING ( Atividades[Activity], "UpdateApp" )
			VAR Dataflow =
			    CONTAINSSTRING ( Atividades[Activity], "Dataflow" )
			RETURN
			    SWITCH (
			        TRUE (),
			        API
			            && Atividades[ObjectType] = BLANK (), "API PowerBI",
			        FOLDER
			            && Atividades[ObjectType] = BLANK (), "Organização Workspace",
			        DatSet, "Dataset",
			        COPILOT, "Copilot",
			        REPORT, "Report",
			        ATUALIZACAO, "Atualização",
			        ACESSO, "Acesso ao Aplicativo",
			        LAKE, "Lakehouse",
			        exter, "Integração Externa",
			        app, "Aplicativo",
			        Dataflow, "Dataflow",
			        Atividades[ObjectType]
			    )
			
			
			```
		lineageTag: 6358d01e-3bbc-4a77-916c-41f4b9e28917
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _SubCategoria = ```
			
			SWITCH(
			    TRUE(),
			    Atividades[ObjectType] = BLANK(), Atividades[ArtifactKind], 
			    Atividades[ObjectType])
			```
		lineageTag: a2f0b2ea-df94-48db-8b93-3f4606704fe5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

