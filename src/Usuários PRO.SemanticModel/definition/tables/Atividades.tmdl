	partition Atividades = m
		mode: import
		source = ```
				let
				    Fonte = Sql.Database("kt5q7cqws6juvekyty5hebxrry-vvqpi4ki73tuda7l2ansqa4d5u.datawarehouse.fabric.microsoft.com", "FUAM_Lakehouse"),
				    dbo_activities = Fonte{[Schema="dbo",Item="activities"]}[Data],
				     RemovedColumns = Table.RemoveColumns(dbo_activities, {
				        "FolderDisplayName", "DataflowType", "CapacityUsers", "PaginatedReportDataSources", "ImportSource", 
				        "OrgAppPermission", "DeploymentPipelineAccesses", "OrganizationalGalleryItemId", "Schedules", 
				        "TemplateAppObjectId", "TemplateAppIsInstalledWithAutomation", "TenantAdminFeatureSwitches", "SwitchState", 
				        "DatasourceId", "GatewayClustersObjectIds", "DeploymentPipelineObjectId", "ExportEventStartDateTimeParameter", 
				        "ExternalResource", "DashboardName", "AppId", "IncludeSubartifacts", "DeploymentPipelineDisplayName", 
				        "ResultStatus", "CustomVisualAccessTokenSiteUri", "SharingInformation", "GatewayType", "FolderAccessRequests", 
				        "DeploymentPipelineStageOrder", "IsTenantAdminApi", "ImportType", "RequiredWorkspaces", "ExportedArtifactInfo", 
				        "TemplatePackageName", "PackageId", "DatasourceDetails", "ReportMobileLayoutAction", "Lineage", 
				        "DataflowRefreshScheduleType", "DataflowName", "Datasets", "ImportDisplayName", "DatasourceInformations", 
				        "IsUpdateAppActivity", "GatewayStatus", "TenantAdminFeatureSwitchProperties", "AppName", 
				        "GatewayId", "ModelsSnapshots", "ArtifactAccessRequestInfo", "CopiedReportId", "IsTemplateAppFromMarketplace", 
				        "GitIntegrationRequest", "SubscriptionDetails", "GatewayClusterId", "HasFullReportAttachment", 
				         "SubscribeeInformation", "ExportEventEndDateTimeParameter", 
				        "AggregatedWorkspaceInformation", "GatewayName", "TemplateAppOwnerTenantObjectId", "DeploymentPipelineId", 
				        "CopiedReportName", "OrganizationalGalleryItemDisplayName", "FolderObjectId", "AppReportId", 
				        "WorkspacesSemicolonDelimitedList", "ItemsCount", "ExternalSubscribeeInformation", "TemplateAppVersion", 
				        "TemplateAppFolderObjectId", "SharingAction", "DatasourceObjectIds", "IncludeExpressions", "Experience", 
				        "SharingScope", "TileText", "CustomVisualAccessTokenResourceId", "CapacityState", 
				        "OrganizationalGalleryItemPublishTime", "GatewayClusterDatasources", "SubscriptionSchedule", "UserInformation", 
				        "ModelId", "CredentialSetupMode", "ExcludePersonalWorkspaces", "DashboardId", "DeploymentPipelineOperationId", 
				        "WorkspaceAccessList", "TargetWorkspaceId", "Monikers", "ExportedArtifactDownloadInfo", "UpdateDatasourcesRequest", 
				        "DataflowId", "ConsumptionMethod", "ImportId", "ModelSettings", "GatewayClusters", "ActionSource", 
				        "ActionSourceDetail", "ArtifactObjectId", "ArtifactType", "AuditedArtifactInformation", 
				        "DataflowAccessTokenRequestParameters", "DataflowAllowNativeQueries", "DatasetCertificationStage", "Datasources", 
				        "DomainId", "EmbedTokenId", "EndPoint", "ItemType", "LabelEventType", "MentionedUsersInformation", 
				        "OldSensitivityLabelId", "OriginalOwner", "OwningAppContext", "PinReportToTabInformation", 
				        "PowerPlatformEnvironmentId", "PreppedForCopilot", "ReportCertificationStage", "SensitivityLabelEventData", 
				        "SensitivityLabelId", "ShareLinkId", "TakingOverOwner", "WorkspacesModifiedSince", "GatewayMemberId", 
				        "ShareWithCurrentFilter", "AccessRequestMessage", "AccessRequestType", "MembershipInformation", "SnapshotId", 
				        "InPlaceSharingEnabled"
				    }),
				    #"Linhas Filtradas" = Table.SelectRows(RemovedColumns, each ([CapacityName] = "eletrobras") and 
				        Date.IsInPreviousNDays([CreationDate], 60)
				),
				
				    // Extrai usuário antes do @
				    AddUsuario = Table.AddColumn(#"Linhas Filtradas", "Usuário", each Text.BeforeDelimiter([UserId], "@"), type text),
				
				    // Extrai hora da criação como texto
				    AddTimeText = Table.AddColumn(AddUsuario, "Time", each Text.AfterDelimiter([CreationTime], "T")),
				
				    // Converte para tipo time
				    ConvertedTime = Table.TransformColumnTypes(AddTimeText, {{"Time", type time}}),
				
				    // Subtrai 3 horas
				    AddHorario = Table.AddColumn(ConvertedTime, "Horario", each [Time] - #duration(0, 3, 0, 0), type time),
				
				    // Ajusta tipo da coluna CreationTime
				    FinalTypes = Table.TransformColumnTypes(AddHorario, {{"CreationTime", type datetime}})
				in
				    FinalTypes
				```

	changedProperty = Name

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

